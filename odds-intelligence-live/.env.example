# Copia come .env; NON inserire le chiavi nei file condivisi.
ALLSPORTS_API_KEY=
ODDS_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Configurazione prudente: 60 secondi, solo segnalazioni > 70%.
POLL_SECONDS=60
ALERT_THRESHOLD=0.70
MIN_BOOKMAKERS=3
MIN_PREMATCH_PROBABILITY=0.62
# Tennis: quota prepartita registrata per il favorito svantaggiato, massimo 1.20.
MAX_TENNIS_PREMATCH_ODDS=1.20
MAX_ODDS_AGE_SECONDS=180
MAX_BOOKMAKER_SPREAD=0.10

# Chiavi di campionati supportate da The Odds API; personalizzabili.
# Aggiungere sport aumenta le richieste e i costi API.
WATCH_SPORT_KEYS=basketball_nba,basketball_euroleague,soccer_italy_serie_a,soccer_epl
# Numero massimo di competizioni tennis scoperte automaticamente dall'elenco provider.
MAX_AUTO_TENNIS_KEYS=8
MAX_ODDS_REQUESTS_PER_DAY=4000
ODDS_REGIONS=eu

# Non invia messaggi se true. Utile per la prima verifica.
DRY_RUN=true
DB_PATH=/data/monitor.sqlite3
CONTEXT_FILE=/app/context.json
