# Copia come .env; NON inserire le chiavi nei file condivisi e NON committare .env.
ALLSPORTS_API_KEY=
ODDS_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Non invia messaggi se true. Cambiare solo dopo validazione e decisione esplicita.
DRY_RUN=true
DB_PATH=/data/monitor.sqlite3
CONTEXT_FILE=/app/context.json

# --- Ciclo e quote ---------------------------------------------------------------
POLL_SECONDS=60
MIN_BOOKMAKERS=3
MAX_ODDS_AGE_SECONDS=180
MAX_BOOKMAKER_SPREAD=0.10
ODDS_REGIONS=eu
# Campionati The Odds API da seguire (i tornei tennis attivi si aggiungono da soli).
WATCH_SPORT_KEYS=basketball_nba,basketball_euroleague,soccer_italy_serie_a,soccer_epl
MAX_AUTO_TENNIS_KEYS=40
# Tetto giornaliero di crediti The Odds API (costo per chiamata = mercati x regioni = 1 qui).
MAX_ODDS_REQUESTS_PER_DAY=500
# Quote pre-partita: al massimo una chiamata a campionato ogni N secondi.
PREMATCH_REFRESH_SECONDS=3600
# Calendario eventi The Odds API (gratuito da documentazione).
ODDS_EVENTS_REFRESH_SECONDS=900
# Quote pre-partita AllSports per event_key (copre anche Challenger/ITF).
USE_ALLSPORTS_ODDS=true
# true = quote live anche per partite non modellabili (solo per raccolta dati, consuma crediti).
COLLECT_ALL_LIVE_ODDS=false

# --- Selezione ---------------------------------------------------------------------
ALERT_THRESHOLD=0.70
MIN_PREMATCH_PROBABILITY=0.62
MAX_TENNIS_PREMATCH_ODDS=1.20
# Livelli tennis per cui lo storico importato autorizza alert (challenger/itf solo con storico dedicato).
TENNIS_MODEL_TIERS=atp,wta
# Lo storico descrive l'inizio del set: oltre questi game giocati nel set in corso, niente alert.
TENNIS_MAX_GAMES_INTO_SET=4
# Calcio: lo storico descrive l'intervallo; minuti di tolleranza dopo il 45' (0 = solo intervallo).
FOOTBALL_HT_TOLERANCE_MIN=0
REQUIRE_VERIFIED_CONTEXT=false

# --- Modello calibrato ---------------------------------------------------------------
MODEL_BANDWIDTH=0.05
MODEL_MIN_SAMPLE=150
# z unilaterale del limite inferiore di Wilson (1.2816 = 90%).
MODEL_Z=1.2816
VALIDATION_MIN_ALERTS=30
VALIDATION_MAX_GAP=0.05

# --- Mercato live e valore -----------------------------------------------------------
REQUIRE_LIVE_MARKET=true
# true = alert solo se la quota live offerta supera la quota equa del modello di MIN_EDGE.
REQUIRE_VALUE=true
MIN_EDGE=0.02
# Probabilità finale = MODEL_WEIGHT x storico + (1 - MODEL_WEIGHT) x mercato live senza margine.
# 0.5 = media semplice; 1 = solo storico; 0 = solo mercato.
MODEL_WEIGHT=0.5
# Blocco extra se il mercato live è sotto lo storico di oltre questo scarto (1.0 = spento).
MAX_MODEL_MARKET_GAP=1.0
