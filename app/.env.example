# Copy this file to .env and fill in your own Supabase project credentials.
# Find these in your Supabase project: Settings -> API.
# Both are safe to ship in the app bundle (the anon key is public by design;
# access is enforced by Row Level Security policies in supabase/schema.sql).

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
